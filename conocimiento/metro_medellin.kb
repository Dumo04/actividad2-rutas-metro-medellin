% ---------------------------------------------------------------------
% 3. TRAMOS: tramo(estacion_a, estacion_b, linea, minutos)
%    Se declaran en un solo sentido; la regla de simetría los completa.
% ---------------------------------------------------------------------
% --- Línea A (norte -> sur)
