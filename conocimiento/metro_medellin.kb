% ---------------------------------------------------------------------
% 4. PARÁMETROS
% ---------------------------------------------------------------------
% Minutos adicionales por cada transbordo (caminar + esperar el siguiente vehículo).
penalizacion_transbordo(5).

% Estaciones fuera de servicio (se pueden agregar aquí o con --cerrar).
% cerrada(san_antonio).

% ---------------------------------------------------------------------
% 5. REGLAS LÓGICAS (inferencia por encadenamiento hacia adelante)
% ---------------------------------------------------------------------
% R1. Toda estación que tiene nombre es una estación.
estacion(X) :- nombre(X, _).

% R2-R3. Los tramos son bidireccionales (simetría).
conectado(X, Y, L, T) :- tramo(X, Y, L, T).
conectado(X, Y, L, T) :- tramo(Y, X, L, T).

% R4. Una línea sirve a una estación si pasa por ella.
sirve(L, X) :- conectado(X, _, L, _).

% R5. Una estación es de transbordo si la sirven dos líneas distintas.
transbordo(X) :- sirve(L1, X), sirve(L2, X), L1 != L2.

% R6. Una estación está disponible si existe y no está cerrada.
disponible(X) :- estacion(X), not cerrada(X).

% R7. Un movimiento es válido si ambos extremos están disponibles.
movimiento(X, Y, L, T) :- conectado(X, Y, L, T), disponible(X), disponible(Y).

% R8. Dos estaciones son vecinas si hay un movimiento válido entre ellas.
vecina(X, Y) :- movimiento(X, Y, _, _).

% R9-R10. Alcanzabilidad (cierre transitivo): de X se puede llegar a Y.
alcanzable(X, Y) :- vecina(X, Y).
alcanzable(X, Z) :- alcanzable(X, Y), vecina(Y, Z).

% R11. Dos líneas se conectan si comparten una estación de transbordo.
conecta_lineas(L1, L2) :- sirve(L1, X), sirve(L2, X), L1 != L2.
