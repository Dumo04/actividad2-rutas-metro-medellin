% =====================================================================
%  BASE DE CONOCIMIENTO - Sistema Metro de Medellín (SITVA, simplificado)
% ---------------------------------------------------------------------
%  Sintaxis tipo Prolog/Datalog:
%    hecho(arg1, arg2).
%    cabeza(X, Y) :- cuerpo1(X, Z), cuerpo2(Z, Y), not otro(X), X != Y.
%  - Constantes: en minúscula (san_antonio) o entre comillas ("San Antonio").
%  - Variables: empiezan con mayúscula o con _ .
%  - Comentarios: empiezan con % .
%
%  Incluye: Líneas A y B (metro), metrocables K, J, L, H, M y P,
%  Tranvía de Ayacucho (T-A) y Metroplús Línea 1.
%  NOTA: modelo académico SIMPLIFICADO. Las estaciones y conexiones son
%  reales, pero los tiempos (minutos) y coordenadas son aproximados.
%  Se pueden ajustar editando este archivo sin tocar el código Python.
% =====================================================================

% ---------------------------------------------------------------------
% 1. LÍNEAS
% ---------------------------------------------------------------------
linea(linea_a,     "Línea A - Metro (Niquía - La Estrella)").
linea(linea_b,     "Línea B - Metro (San Antonio - San Javier)").
linea(linea_k,     "Línea K - Metrocable (Acevedo - Santo Domingo)").
linea(linea_l,     "Línea L - Metrocable Arví").
linea(linea_j,     "Línea J - Metrocable (San Javier - La Aurora)").
linea(linea_p,     "Línea P - Metrocable (Acevedo - El Progreso)").
linea(linea_h,     "Línea H - Metrocable (Oriente - Villa Sierra)").
linea(linea_m,     "Línea M - Metrocable (Miraflores - Trece de Noviembre)").
linea(tranvia_t,   "Línea T-A - Tranvía de Ayacucho").
linea(metroplus_1, "Línea 1 - Metroplús").

